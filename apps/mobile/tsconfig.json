{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    // Workspace packages ship TypeScript source that imports "./auth.ts" style paths.
    "allowImportingTsExtensions": true,
    // Expo writes expo-env.d.ts only when typed routes are on; reference its globals directly.
    "types": ["expo/types"]
  },
  "include": ["**/*.ts", "**/*.tsx", "vitest.config.mts", "nativewind-env.d.ts"]
}
