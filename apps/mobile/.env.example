# .env로 복사한다(git에서 제외됨). Expo는 번들링할 때 EXPO_PUBLIC_* 변수를 인라인하므로,
# 값을 바꾼 뒤에는 `expo start`를 다시 시작한다.
#   iOS 시뮬레이터, 웹:  http://localhost:3000/rpc   (설정하지 않았을 때의 기본값)
#   Android 에뮬레이터:  http://10.0.2.2:3000/rpc
#   실기기:              http://<내 컴퓨터의 LAN IP>:3000/rpc
EXPO_PUBLIC_API_URL=http://localhost:3000/rpc
