# Copy to .env (git-ignored). Expo inlines EXPO_PUBLIC_* variables when it bundles, so restart
# `expo start` after a change.
#   iOS simulator, web:  http://localhost:3000/rpc   (the default when unset)
#   Android emulator:    http://10.0.2.2:3000/rpc
#   Physical device:     http://<your computer's LAN IP>:3000/rpc
EXPO_PUBLIC_API_URL=http://localhost:3000/rpc
