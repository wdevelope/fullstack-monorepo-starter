# 로컬 개발용으로 .env에 복사한다. 실제 값은 git에 넣지 않는다.
DATABASE_URL=postgres://starter:starter@localhost:5432/starter
# 통합 테스트는 데이터베이스 이름에 "test"가 들어 있지 않으면 실행을 거부한다.
TEST_DATABASE_URL=postgres://starter:starter@localhost:5432/starter_test
# 32자 이상이어야 한다. 다음 명령으로 만든다: node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
JWT_SECRET=
PORT=3000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
# 리버스 프록시(로드밸런서) 뒤에서만 true. 켜면 X-Forwarded-For의 첫 주소로 요청 횟수를 센다.
TRUST_PROXY=false
