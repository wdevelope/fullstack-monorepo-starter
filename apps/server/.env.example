# Copy to .env for local development. Real values never go in git.
DATABASE_URL=postgres://starter:starter@localhost:5432/starter
# Integration tests refuse to run unless the database name contains "test".
TEST_DATABASE_URL=postgres://starter:starter@localhost:5432/starter_test
# At least 32 characters. Generate one with: node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
JWT_SECRET=
PORT=3000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
